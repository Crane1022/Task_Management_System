# Copy to .env.local and fill in from Firebase Console > Project settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Widebed PMS web app (staff sign in with their PMS email and password). Public web config, not a secret.
VITE_PMS_API_KEY=
VITE_PMS_AUTH_DOMAIN=
VITE_PMS_PROJECT_ID=
VITE_PMS_MESSAGING_SENDER_ID=
VITE_PMS_APP_ID=
# Server only (Vercel > Settings > Environment Variables, never in this file or Git):
#   TMS_SERVICE_ACCOUNT  the whole service account JSON of THIS (TMS) Firebase project, on one line
#   ALLOWED_ORIGINS      PMS site address(es), comma separated, e.g. https://pms.example.com,http://localhost:5173
#   PMS_PROJECT_ID       optional, defaults to widebed-pmsdashboard
